{% comment %}
  R4R Premium Product Card Snippet
  Accepts:
  - product: {Object} Shopify Product object
{% endcomment %}

{%- assign main_image = product.featured_media -%}
{%- assign hover_image = product.media[1] | default: product.featured_media -%}

<div class="group relative cursor-pointer r4r-product-card-item">
  {% comment %} Product Image Frame {% endcomment %}
  <div class="relative aspect-[3/4] bg-beige-light rounded-2xl overflow-hidden shadow-md group-hover:shadow-xl transition-all duration-500 border border-emerald-medium/5">
    
    {% comment %} Badges {% endcomment %}
    {%- if product.compare_at_price > product.price -%}
      <span class="absolute top-4 left-4 z-10 bg-emerald-dark text-gold-pale font-sans text-[10px] tracking-widest font-semibold uppercase px-3 py-1.5 rounded-full border border-gold-medium/20 shadow-sm">
        Sale
      </span>
    {%- elsif product.tags contains 'Pre-Order' or product.tags contains 'preorder' -%}
      <span class="absolute top-4 left-4 z-10 bg-emerald-dark text-gold-pale font-sans text-[10px] tracking-widest font-semibold uppercase px-3 py-1.5 rounded-full border border-gold-medium/20 shadow-sm">
        Pre-Order
      </span>
    {%- else -%}
      <span class="absolute top-4 left-4 z-10 bg-emerald-dark text-gold-pale font-sans text-[10px] tracking-widest font-semibold uppercase px-3 py-1.5 rounded-full border border-gold-medium/20 shadow-sm">
        Organic
      </span>
    {%- endif -%}

    {% comment %} Image Cross-fade {% endcomment %}
    <img
      src="{{ main_image | image_url: width: 600 }}"
      alt="{{ product.title | escape }}"
      loading="lazy"
      class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 group-hover:opacity-0"
    />
    <img
      src="{{ hover_image | image_url: width: 600 }}"
      alt="{{ product.title | escape }} Alternate"
      loading="lazy"
      class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 opacity-0 group-hover:opacity-100"
    />

    {% comment %} Smooth dark overlay when hovered {% endcomment %}
    <div class="absolute inset-0 bg-emerald-dark/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

    {% comment %} Quick Add Form Overlay {% endcomment %}
    <div class="absolute bottom-6 inset-x-6 z-20 transform translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
      {%- form 'product', product -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button
          type="submit"
          class="w-full bg-emerald-dark hover:bg-emerald-medium text-gold-pale font-sans text-xs tracking-widest font-semibold uppercase py-3.5 rounded-full flex items-center justify-center gap-2 shadow-lg transition-all duration-300 active:scale-97 border border-gold-light/20"
        >
          <svg class="w-4 h-4 text-gold-medium shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          Quick Add &bull; {{ product.price | money }}
        </button>
      {%- endform -%}
    </div>
  </div>

  {% comment %} Product Info {% endcomment %}
  <div class="mt-6 text-center">
    <a href="{{ product.url }}">
      <h3 class="font-serif font-medium text-lg md:text-xl text-emerald-dark hover:text-gold-medium transition-colors duration-300">
        {{ product.title | escape }}
      </h3>
    </a>
    
    {% comment %} Prices {% endcomment %}
    <div class="flex items-center justify-center gap-3 mt-2">
      <span class="font-sans text-base font-semibold text-emerald-medium">
        {{ product.price | money }}
      </span>
      {%- if product.compare_at_price > product.price -%}
        <span class="font-sans text-sm text-charcoal/30 line-through">
          {{ product.compare_at_price | money }}
        </span>
      {%- endif -%}
    </div>

    {%- if product.metafields.descriptors.subtitle.value != blank -%}
      <p class="mt-3 font-sans text-xs text-charcoal/50 leading-relaxed font-light max-w-[280px] mx-auto">
        {{ product.metafields.descriptors.subtitle.value }}
      </p>
    {%- else -%}
      <p class="mt-3 font-sans text-xs text-charcoal/50 leading-relaxed font-light max-w-[280px] mx-auto">
        {{ product.description | strip_html | truncatewords: 15 }}
      </p>
    {%- endif -%}
  </div>
</div>
