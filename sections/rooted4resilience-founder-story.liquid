{{ 'r4r-bundle.css' | asset_url | stylesheet_tag }}

<section
  id="story"
  class="relative py-24 md:py-32 bg-beige-light overflow-hidden"
>
  {% comment %} Decorative blur bubbles {% endcomment %}
  <div class="absolute top-1/2 left-0 -translate-y-1/2 w-64 h-64 bg-emerald-medium/5 rounded-full blur-3xl pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
    {/* Left: Premium Parallax Image */}
    <div class="lg:col-span-5 relative w-full aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl border border-emerald-medium/5">
      {/* Gold Decorative Border */}
      <div class="absolute inset-4 border border-gold-medium/20 rounded-xl pointer-events-none z-10"></div>
      
      {%- if section.settings.founder_image != blank -%}
        <img
          src="{{ section.settings.founder_image | image_url: width: 800 }}"
          alt="{{ section.settings.founder_name | escape }}"
          class="absolute top-0 left-0 w-full h-[120%] object-cover object-top filter contrast-[1.02] brightness-95 r4r-parallax-img"
          style="transform: translateY(-5%);"
        />
      {%- else -%}
        <img
          src="{{ 'founder.png' | asset_url }}"
          alt="{{ section.settings.founder_name | escape }}"
          class="absolute top-0 left-0 w-full h-[120%] object-cover object-top filter contrast-[1.02] brightness-95 r4r-parallax-img"
          style="transform: translateY(-5%);"
        />
      {%- endif -%}
      
      {/* Subtle overlay */}
      <div class="absolute inset-0 bg-gradient-to-t from-emerald-dark/15 via-transparent to-transparent pointer-events-none"></div>
    </div>

    {/* Right: Editorial Narrative */}
    <div class="lg:col-span-7 flex flex-col justify-center">
      <span class="font-sans text-xs tracking-widest font-semibold uppercase text-gold-medium mb-3">
        {{ section.settings.chapter_title | escape }}
      </span>

      <h2 class="font-serif font-semibold text-3xl md:text-5xl leading-tight text-emerald-dark mb-6">
        {{ section.settings.heading | escape }}
      </h2>

      <div class="space-y-6 text-charcoal/80 font-sans text-base md:text-lg leading-relaxed font-light">
        <p>{{ section.settings.paragraph_1 | escape }}</p>
        <p>{{ section.settings.paragraph_2 | escape }}</p>
        <p>{{ section.settings.paragraph_3 | escape }}</p>
      </div>

      {/* Founder Quote card */}
      {%- if section.settings.founder_quote != blank -%}
        <div class="mt-10 p-8 rounded-2xl bg-beige-dark border-l-4 border-gold-medium shadow-sm">
          <p class="font-serif italic text-lg text-emerald-dark leading-relaxed mb-4">
            "{{ section.settings.founder_quote | escape }}"
          </p>
          <div class="flex items-center gap-3">
            <div class="w-6 h-[1px] bg-gold-medium"></div>
            <div>
              <span class="font-sans text-sm font-semibold uppercase tracking-wider text-emerald-dark block">
                {{ section.settings.founder_name | escape }}
              </span>
              <span class="font-sans text-xs text-charcoal/50 uppercase tracking-widest font-medium">
                {{ section.settings.founder_title | escape }}
              </span>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% comment %} Vanilla JS Parallax logic {% endcomment %}
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const parallaxImg = document.querySelector("#story .r4r-parallax-img");
    if (!parallaxImg) return;
    
    window.addEventListener("scroll", function() {
      const rect = parallaxImg.parentElement.getBoundingClientRect();
      const scrolledFraction = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);
      if (scrolledFraction >= 0 && scrolledFraction <= 1) {
        const yValue = (scrolledFraction - 0.5) * 40; // max shift 20px up/down
        parallaxImg.style.transform = `translateY(${yValue}px)`;
      }
    });
  });
</script>

{% schema %}
{
  "name": "R4R Founder Story",
  "settings": [
    {
      "type": "text",
      "id": "chapter_title",
      "label": "Chapter Title",
      "default": "Chapter 02 • The Mission"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story of Strength"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "Rooted 4 Resilience was born out of a simple, powerful conviction: that style and substance should never be mutually exclusive. Our pieces represent more than sustainable, organic luxury—they are symbols of personal and collective strength."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "We design with GOTS-certified organic cotton, clean tailoring, and custom botanical inspirations to create apparel that honors your body and the earth. But our true mission lies beyond the fabric."
    },
    {
      "type": "textarea",
      "id": "paragraph_3",
      "label": "Paragraph 3",
      "default": "For every garment purchased, we directly allocate $5 to support circles, maternal mental health therapy grants, and crisis housing. We believe that when you support a mother, you elevate an entire community."
    },
    {
      "type": "image_picker",
      "id": "founder_image",
      "label": "Founder Image"
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder Name",
      "default": "Linsi"
    },
    {
      "type": "text",
      "id": "founder_title",
      "label": "Founder Title",
      "default": "Founder & Creative Director"
    },
    {
      "type": "textarea",
      "id": "founder_quote",
      "label": "Founder Quote",
      "default": "We built Rooted 4 Resilience to blend the elegance of premium sustainable fashion with the heartbeat of real community support."
    }
  ],
  "presets": [
    {
      "name": "R4R Founder Story"
    }
  ]
}
{% endschema %}
