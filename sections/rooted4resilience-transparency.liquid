{{ 'r4r-bundle.css' | asset_url | stylesheet_tag }}

<section
  id="transparency"
  class="py-24 md:py-32 bg-beige-light relative overflow-hidden"
>
  {% comment %} Background decorative elements {% endcomment %}
  <div class="absolute top-1/2 left-0 -translate-y-1/2 w-64 h-64 bg-emerald-medium/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    
    {/* Header */}
    <div class="text-center max-w-2xl mx-auto mb-20">
      <span class="font-sans text-xs tracking-widest font-semibold uppercase text-gold-medium mb-3 block">
        {{ section.settings.chapter_title | escape }}
      </span>
      <h2 class="font-serif font-semibold text-3xl md:text-5xl text-emerald-dark mb-4">
        {{ section.settings.heading | escape }}
      </h2>
      <p class="font-sans text-charcoal/60 font-light text-base md:text-lg">
        {{ section.settings.subheading | escape }}
      </p>
    </div>

    {/* Dashboard Split: Timeline vs Allocation Chart */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
      
      {/* Left: Impact Timeline */}
      <div class="lg:col-span-6 flex flex-col items-center lg:items-start">
        <h3 class="font-serif font-semibold text-2xl text-emerald-dark mb-10 flex items-center gap-2">
          <svg class="w-5 h-5 text-gold-medium" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 3v18h18"></path><path d="m19 9-5 5-4-4-3 3"></path></svg> Growth Progress
        </h3>

        {/* Timeline Wrapper */}
        <div class="relative pl-10 md:pl-16 w-full r4r-timeline-track">
          
          {/* Back track line */}
          <div class="absolute left-4 md:left-8 top-2 bottom-2 w-[3px] bg-emerald-medium/15 rounded-full"></div>
          
          {/* Animated fill line */}
          <div
            class="absolute left-4 md:left-8 top-2 w-[3px] bg-gradient-to-b from-gold-medium to-emerald-medium rounded-full origin-top r4r-timeline-bar transition-all duration-1000"
            style="height: 0%;"
          ></div>

          {/* Milestones list */}
          <div class="space-y-12">
            {%- for block in section.blocks -%}
              <div
                class="r4r-milestone-card relative flex flex-col md:flex-row md:items-center gap-4 md:gap-8 text-left opacity-0 translate-y-4 transition-all duration-700"
                {{ block.shopify_attributes }}
              >
                {/* Circle Dot Marker */}
                <div class="absolute -left-[42px] md:-left-[58px] top-1 w-[20px] h-[20px] rounded-full bg-beige-light border-4 border-gold-medium z-10 shadow-sm"></div>

                {/* Month Label */}
                <div class="font-serif italic text-2xl font-bold text-gold-medium shrink-0 w-16">
                  {{ block.settings.month | escape }}
                </div>

                {/* Content Box */}
                <div class="bg-beige-dark p-6 rounded-2xl border border-emerald-medium/5 shadow-sm flex-grow">
                  <div class="font-sans text-xl font-bold text-emerald-dark">
                    {{ block.settings.amount | escape }} Donated
                  </div>
                  <p class="font-sans text-sm text-charcoal/65 mt-1 font-light">
                    {{ block.settings.note | escape }}
                  </p>
                </div>
              </div>
            {%- else -%}
              <p class="text-charcoal/50 italic pl-4">No progress milestones added yet.</p>
            {%- endfor -%}
          </div>

        </div>
      </div>

      {/* Right: Allocation Circle Chart */}
      <div class="lg:col-span-6 bg-beige-dark rounded-3xl p-8 md:p-12 border border-emerald-medium/5 shadow-sm text-center lg:text-left">
        <h3 class="font-serif font-semibold text-2xl text-emerald-dark mb-4 flex items-center justify-center lg:justify-start gap-2">
          <svg class="w-5 h-5 text-gold-medium" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg> Donation Allocation
        </h3>
        <p class="font-sans text-sm text-charcoal/65 font-light leading-relaxed mb-10">
          {{ section.settings.audit_text | escape }}
        </p>

        <div class="flex flex-col md:flex-row items-center gap-12 justify-center lg:justify-start">
          
          {/* Concentric Circle SVGs */}
          {%- assign p1 = section.settings.percent_1 -%}
          {%- assign p2 = section.settings.percent_2 -%}
          {%- assign p3 = section.settings.percent_3 -%}
          
          <div class="relative w-48 h-48 r4r-allocation-chart">
            <svg class="w-full h-full transform -rotate-90" viewBox="0 0 120 120">
              {% comment %} Outer circle track: Outer is Direct Programs {% endcomment %}
              <circle cx="60" cy="60" r="48" stroke="#064e3b" strokeWidth="6" fill="transparent" opacity="0.1" />
              <circle
                class="r4r-allocation-circle"
                cx="60" cy="60" r="48"
                stroke="#064e3b" stroke-width="6" fill="transparent"
                stroke-linecap="round"
                data-percent="{{ p1 }}"
                style="stroke-dasharray: 301.6; stroke-dashoffset: 301.6; transition: stroke-dashoffset 1.5s ease-out-in;"
              />

              {% comment %} Middle circle track: Middle is Community Circles {% endcomment %}
              <circle cx="60" cy="60" r="38" stroke="#d97706" strokeWidth="6" fill="transparent" opacity="0.1" />
              <circle
                class="r4r-allocation-circle"
                cx="60" cy="60" r="38"
                stroke="#d97706" stroke-width="6" fill="transparent"
                stroke-linecap="round"
                data-percent="{{ p2 }}"
                style="stroke-dasharray: 238.7; stroke-dashoffset: 238.7; transition: stroke-dashoffset 1.5s ease-out-in;"
              />

              {% comment %} Inner circle track: Inner is Operations {% endcomment %}
              <circle cx="60" cy="60" r="28" stroke="#0f766e" strokeWidth="6" fill="transparent" opacity="0.1" />
              <circle
                class="r4r-allocation-circle"
                cx="60" cy="60" r="28"
                stroke="#0f766e" stroke-width="6" fill="transparent"
                stroke-linecap="round"
                data-percent="{{ p3 }}"
                style="stroke-dasharray: 175.9; stroke-dashoffset: 175.9; transition: stroke-dashoffset 1.5s ease-out-in;"
              />
            </svg>

            {/* Center text badge */}
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span class="font-serif italic text-3xl font-bold text-emerald-dark">100%</span>
              <span class="font-sans text-[8px] uppercase tracking-widest text-charcoal/50">Audited</span>
            </div>
          </div>

          {/* Legend with matching colors */}
          <div class="flex flex-col gap-6 text-left w-full md:w-auto">
            {/* Direct Programs */}
            <div class="flex items-start gap-4">
              <div class="w-4 h-4 rounded-full bg-emerald-medium shrink-0 mt-1"></div>
              <div>
                <div class="font-sans font-bold text-emerald-dark text-base">
                  {{ p1 }}% {{ section.settings.label_1 | escape }}
                </div>
                <p class="font-sans text-xs text-charcoal/60 leading-relaxed font-light">
                  {{ section.settings.desc_1 | escape }}
                </p>
              </div>
            </div>

            {/* Community Circles */}
            <div class="flex items-start gap-4">
              <div class="w-4 h-4 rounded-full bg-gold-medium shrink-0 mt-1"></div>
              <div>
                <div class="font-sans font-bold text-emerald-dark text-base">
                  {{ p2 }}% {{ section.settings.label_2 | escape }}
                </div>
                <p class="font-sans text-xs text-charcoal/60 leading-relaxed font-light">
                  {{ section.settings.desc_2 | escape }}
                </p>
              </div>
            </div>

            {/* Operations */}
            <div class="flex items-start gap-4">
              <div class="w-4 h-4 rounded-full bg-emerald-accent shrink-0 mt-1"></div>
              <div>
                <div class="font-sans font-bold text-emerald-dark text-base">
                  {{ p3 }}% {{ section.settings.label_3 | escape }}
                </div>
                <p class="font-sans text-xs text-charcoal/60 leading-relaxed font-light">
                  {{ section.settings.desc_3 | escape }}
                </p>
              </div>
            </div>

          </div>

        </div>

        {/* Credibility reassurance */}
        {%- if section.settings.reassurance_text != blank -%}
          <div class="mt-10 p-5 rounded-2xl bg-beige-light border border-emerald-medium/5 flex items-center gap-3.5">
            <svg class="w-6 h-6 text-gold-medium shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
            <p class="font-sans text-xs text-charcoal/70 leading-relaxed font-light">
              {{ section.settings.reassurance_text | escape }}
            </p>
          </div>
        {%- endif -%}

      </div>

    </div>

  </div>
</section>

{% comment %} Timeline and Chart animations on scroll {% endcomment %}
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const section = document.getElementById("transparency");
    if (!section) return;

    const timelineBar = section.querySelector(".r4r-timeline-bar");
    const milestoneCards = section.querySelectorAll(".r4r-milestone-card");
    const allocationCircles = section.querySelectorAll(".r4r-allocation-circle");

    function animateTransparency() {
      // Animate timeline bar height
      if (timelineBar) {
        timelineBar.style.height = "96%";
      }

      // Slide and fade milestones sequentially
      milestoneCards.forEach((card, idx) => {
        setTimeout(() => {
          card.classList.remove("opacity-0", "translate-y-4");
          card.classList.add("opacity-100", "translate-y-0");
        }, idx * 250);
      });

      // Animate circular chart values
      allocationCircles.forEach(circle => {
        const percent = parseFloat(circle.getAttribute("data-percent"));
        const radius = parseFloat(circle.getAttribute("r"));
        const circumference = 2 * Math.PI * radius;
        const offset = circumference * (1 - (percent / 100));
        
        circle.style.strokeDasharray = circumference;
        circle.style.strokeDashoffset = offset;
      });
    }

    // Scroll trigger intersection observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateTransparency();
          observer.disconnect(); // run once
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  });
</script>
