{{ 'r4r-bundle.css' | asset_url | stylesheet_tag }}

<section
  id="podcast"
  class="py-24 md:py-32 bg-emerald-dark text-beige-light relative overflow-hidden"
>
  {% comment %} Background radial overlay {% endcomment %}
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(6,78,59,0.3)_0%,rgba(2,44,34,0.9)_100%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    
    {% comment %} Header Title {% endcomment %}
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="font-sans text-xs tracking-widest font-semibold uppercase text-gold-light mb-3 block">
        {{ section.settings.chapter_title | escape }}
      </span>
      <h2 class="font-serif font-semibold text-3xl md:text-5xl text-beige-light mb-4">
        {{ section.settings.heading | escape }}
      </h2>
      <p class="font-sans text-beige-light/70 font-light text-base md:text-lg">
        {{ section.settings.subheading | escape }}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      {% comment %} Left: Active Episode Details & Audio Controls {% endcomment %}
      <div class="lg:col-span-7 bg-emerald-medium/30 border border-beige-light/10 rounded-3xl p-8 md:p-10 backdrop-blur-md r4r-audio-player-container">
        
        {% comment %} Real audio element {% endcomment %}
        <audio id="r4r-main-audio" src=""></audio>

        <div class="flex flex-col sm:flex-row gap-8 items-center sm:items-start">
          {% comment %} Cover Art {% endcomment %}
          <div class="w-40 h-40 rounded-2xl overflow-hidden shadow-xl shrink-0 relative group">
            <img
              id="player-cover-art"
              src=""
              alt="Episode Cover Art"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-black/45 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
              <svg class="w-8 h-8 text-gold-medium" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm12-3c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zM9 10l12-3"></path></svg>
            </div>
          </div>

          {% comment %} Text Info {% endcomment %}
          <div class="text-center sm:text-left flex-grow">
            <span id="player-meta-badge" class="font-sans text-[10px] tracking-widest uppercase font-semibold text-gold-light bg-emerald-medium/50 px-3 py-1 rounded-full border border-beige-light/10">
              Season 1 &bull; Episode 1
            </span>
            
            <h3 id="player-title" class="font-serif font-semibold text-2xl md:text-3xl text-beige-light mt-4 mb-2">
              Episode Title
            </h3>
            
            <p id="player-guest" class="font-sans text-sm text-gold-pale/80 font-medium italic mb-3">
              Guest: Guest Name (Role)
            </p>
            
            <p id="player-description" class="font-sans text-sm text-beige-light/70 font-light leading-relaxed">
              Episode Description details...
            </p>
          </div>
        </div>

        {% comment %} Custom Audio Player Controls {% endcomment %}
        <div class="mt-10 pt-8 border-t border-beige-light/15">
          
          {% comment %} Progress Bar {% endcomment %}
          <div class="flex items-center justify-between text-xs font-mono text-beige-light/50 mb-2">
            <span id="player-current-time">00:00</span>
            <span id="player-duration">00:00</span>
          </div>

          <input
            id="player-progress-bar"
            type="range"
            min="0"
            max="100"
            value="0"
            class="w-full h-1 bg-beige-light/15 rounded-lg appearance-none cursor-pointer accent-gold-medium focus:outline-none mb-8"
          />

          {% comment %} Button Controls {% endcomment %}
          <div class="flex items-center justify-between">
            
            {% comment %} Volume icon indicator {% endcomment %}
            <div class="flex items-center gap-1.5 text-beige-light/45">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>
              <span class="text-[10px] uppercase tracking-wider font-mono">Stereo</span>
            </div>

            {% comment %} Main Playback Set {% endcomment %}
            <div class="flex items-center gap-6">
              <button
                id="player-prev-btn"
                type="button"
                class="p-2 text-beige-light/65 hover:text-gold-light disabled:opacity-30 disabled:pointer-events-none transition-colors"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="19 20 9 12 19 4 19 20"></polygon><line x1="5" y1="19" x2="5" y2="5"></line></svg>
              </button>

              <button
                id="player-play-btn"
                type="button"
                class="w-14 h-14 rounded-full bg-gold-medium hover:bg-gold-dark text-beige-light flex items-center justify-center shadow-lg transition-transform hover:scale-106 active:scale-94"
              >
                {% comment %} Play Icon {% endcomment %}
                <svg id="icon-play" class="w-6 h-6 fill-beige-light ml-1" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                {% comment %} Pause Icon {% endcomment %}
                <svg id="icon-pause" class="w-6 h-6 fill-beige-light hidden" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
              </button>

              <button
                id="player-next-btn"
                type="button"
                class="p-2 text-beige-light/65 hover:text-gold-light disabled:opacity-30 disabled:pointer-events-none transition-colors"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="5 4 15 12 5 20 5 4"></polygon><line x1="19" y1="5" x2="19" y2="19"></line></svg>
              </button>
            </div>

            {% comment %} Duration indicator {% endcomment %}
            <div class="text-right">
              <span class="font-sans text-xs text-beige-light/45 block">Duration</span>
              <span id="player-duration-badge" class="font-mono text-sm text-gold-light">0:00</span>
            </div>

          </div>

        </div>

      </div>

      {% comment %} Right: Episode Selector List {% endcomment %}
      <div class="lg:col-span-5 flex flex-col gap-4">
        <h4 class="font-serif font-semibold text-lg text-gold-light uppercase tracking-wider mb-2 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line></svg> Episode Catalog
        </h4>

        <div id="r4r-episodes-list" class="flex flex-col gap-4">
          {%- for block in section.blocks -%}
            <div
              class="r4r-episode-item p-5 rounded-2xl cursor-pointer border transition-all duration-300 flex items-center justify-between bg-emerald-medium/10 text-beige-light/90 border-beige-light/5 hover:bg-emerald-medium/20 hover:border-beige-light/10"
              data-index="{{ forloop.index0 }}"
              data-audio-url="{{ block.settings.audio_url | escape }}"
              data-cover-art="{{ block.settings.cover_art | image_url: width: 300 }}"
              data-season="{{ block.settings.season | escape }}"
              data-episode="{{ block.settings.episode | escape }}"
              data-title="{{ block.settings.title | escape }}"
              data-guest="{{ block.settings.guest | escape }}"
              data-role="{{ block.settings.guest_role | escape }}"
              data-duration="{{ block.settings.duration | escape }}"
              data-description="{{ block.settings.description | escape }}"
              {{ block.shopify_attributes }}
            >
              <div class="pr-4 text-left">
                <span class="font-sans text-[9px] tracking-wider uppercase font-semibold text-gold-light">
                  Episode {{ block.settings.episode | escape }}
                </span>
                <h5 class="font-serif font-semibold text-base md:text-lg mt-1 line-clamp-1">
                  {{ block.settings.title | escape }}
                </h5>
                <span class="font-sans text-xs mt-1 block font-light text-beige-light/50">
                  Guest: {{ block.settings.guest | escape }}
                </span>
              </div>

              <div class="shrink-0 flex items-center justify-center">
                <div class="play-indicator-circle w-8 h-8 rounded-full flex items-center justify-center bg-beige-light/10 text-beige-light transition-colors">
                  <svg class="play-mini-icon w-3.5 h-3.5 fill-current ml-0.5" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                  <svg class="pause-mini-icon w-3.5 h-3.5 fill-current hidden" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
                </div>
              </div>
            </div>
          {%- else -%}
            <p class="text-beige-light/50 italic py-6 text-center">No episodes configured yet.</p>
          {%- endfor -%}
        </div>
      </div>

    </div>

  </div>
</section>

{% comment %} Audio Player Logic {% endcomment %}
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const audio = document.getElementById("r4r-main-audio");
    const playBtn = document.getElementById("player-play-btn");
    const iconPlay = document.getElementById("icon-play");
    const iconPause = document.getElementById("icon-pause");
    const progressBar = document.getElementById("player-progress-bar");
    const currentTimeText = document.getElementById("player-current-time");
    const durationText = document.getElementById("player-duration");
    const prevBtn = document.getElementById("player-prev-btn");
    const nextBtn = document.getElementById("player-next-btn");

    // Player Elements
    const playerCover = document.getElementById("player-cover-art");
    const playerMeta = document.getElementById("player-meta-badge");
    const playerTitle = document.getElementById("player-title");
    const playerGuest = document.getElementById("player-guest");
    const playerDesc = document.getElementById("player-description");
    const playerDurationBadge = document.getElementById("player-duration-badge");

    const episodeItems = document.querySelectorAll("#podcast .r4r-episode-item");
    if (episodeItems.length === 0) return;

    let currentIdx = 0;
    let isPlaying = false;

    function formatTime(secs) {
      if (isNaN(secs)) return "00:00";
      const minutes = Math.floor(secs / 60);
      const seconds = Math.floor(secs % 60);
      return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
    }

    function loadEpisode(idx) {
      currentIdx = idx;
      const el = episodeItems[idx];
      
      const audioUrl = el.getAttribute("data-audio-url");
      const coverArt = el.getAttribute("data-cover-art");
      const season = el.getAttribute("data-season");
      const episode = el.getAttribute("data-episode");
      const title = el.getAttribute("data-title");
      const guest = el.getAttribute("data-guest");
      const role = el.getAttribute("data-role");
      const duration = el.getAttribute("data-duration");
      const description = el.getAttribute("data-description");

      audio.src = audioUrl;
      playerCover.src = coverArt;
      playerMeta.innerHTML = `Season ${season} &bull; Episode ${episode}`;
      playerTitle.textContent = title;
      playerGuest.textContent = `Guest: ${guest} (${role})`;
      playerDesc.textContent = description;
      playerDurationBadge.textContent = duration;

      // Update active list elements styling
      episodeItems.forEach((item, index) => {
        const circle = item.querySelector(".play-indicator-circle");
        const playIcon = item.querySelector(".play-mini-icon");
        const pauseIcon = item.querySelector(".pause-mini-icon");

        if (index === currentIdx) {
          item.classList.remove("bg-emerald-medium/10", "text-beige-light/90", "border-beige-light/5");
          item.classList.add("bg-beige-light", "text-emerald-dark", "border-gold-medium/35", "shadow-md");
          circle.classList.remove("bg-beige-light/10", "text-beige-light");
          circle.classList.add("bg-emerald-dark", "text-beige-light");
          
          if (isPlaying) {
            playIcon.classList.add("hidden");
            pauseIcon.classList.remove("hidden");
          } else {
            playIcon.classList.remove("hidden");
            pauseIcon.classList.add("hidden");
          }
        } else {
          item.classList.add("bg-emerald-medium/10", "text-beige-light/90", "border-beige-light/5");
          item.classList.remove("bg-beige-light", "text-emerald-dark", "border-gold-medium/35", "shadow-md");
          circle.classList.add("bg-beige-light/10", "text-beige-light");
          circle.classList.remove("bg-emerald-dark", "text-beige-light");
          playIcon.classList.remove("hidden");
          pauseIcon.classList.add("hidden");
        }
      });

      prevBtn.disabled = currentIdx === 0;
      nextBtn.disabled = currentIdx === episodeItems.length - 1;
    }

    function togglePlay() {
      if (isPlaying) {
        audio.pause();
        isPlaying = false;
        iconPlay.classList.remove("hidden");
        iconPause.classList.add("hidden");
      } else {
        audio.play().then(() => {
          isPlaying = true;
          iconPlay.classList.add("hidden");
          iconPause.classList.remove("hidden");
        }).catch(() => {});
      }
      loadEpisode(currentIdx);
    }

    // Initialize player with first track
    loadEpisode(0);

    // Playback events
    playBtn.addEventListener("click", togglePlay);

    prevBtn.addEventListener("click", function() {
      if (currentIdx > 0) {
        loadEpisode(currentIdx - 1);
        if (isPlaying) audio.play().catch(() => {});
      }
    });

    nextBtn.addEventListener("click", function() {
      if (currentIdx < episodeItems.length - 1) {
        loadEpisode(currentIdx + 1);
        if (isPlaying) audio.play().catch(() => {});
      }
    });

    episodeItems.forEach((item, index) => {
      item.addEventListener("click", function() {
        if (index === currentIdx) {
          togglePlay();
        } else {
          loadEpisode(index);
          isPlaying = false;
          togglePlay();
        }
      });
    });

    audio.addEventListener("timeupdate", function() {
      progressBar.value = audio.currentTime;
      currentTimeText.textContent = formatTime(audio.currentTime);
    });

    audio.addEventListener("loadedmetadata", function() {
      progressBar.max = audio.duration;
      durationText.textContent = formatTime(audio.duration);
    });

    audio.addEventListener("ended", function() {
      if (currentIdx < episodeItems.length - 1) {
        loadEpisode(currentIdx + 1);
        audio.play().then(() => {
          isPlaying = true;
        });
      } else {
        isPlaying = false;
        iconPlay.classList.remove("hidden");
        iconPause.classList.add("hidden");
        loadEpisode(0);
      }
    });

    progressBar.addEventListener("input", function() {
      audio.currentTime = progressBar.value;
    });
  });
</script>

{% schema %}
{
  "name": "R4R Podcast Catalog",
  "settings": [
    {
      "type": "text",
      "id": "chapter_title",
      "label": "Chapter Title",
      "default": "Chapter 06 • Podcast"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Voices That Inspire"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Listen in to conversations with advocates, mothers, and therapists on mental health and community resilience."
    }
  ],
  "blocks": [
    {
      "type": "episode",
      "name": "Podcast Episode",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Episode Title",
          "default": "Healing through Connection"
        },
        {
          "type": "text",
          "id": "season",
          "label": "Season",
          "default": "1"
        },
        {
          "type": "text",
          "id": "episode",
          "label": "Episode",
          "default": "1"
        },
        {
          "type": "text",
          "id": "guest",
          "label": "Guest Name",
          "default": "Dr. Sarah Jenkins"
        },
        {
          "type": "text",
          "id": "guest_role",
          "label": "Guest Role/Title",
          "default": "Perinatal Psychologist"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We dive deep into how early postpartum support structures prevent long term mental health struggles for new mothers."
        },
        {
          "type": "text",
          "id": "audio_url",
          "label": "Audio File Link (MP3)",
          "default": "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3"
        },
        {
          "type": "image_picker",
          "id": "cover_art",
          "label": "Cover Art"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "Duration (MM:SS)",
          "default": "34:12"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "R4R Podcast Catalog",
      "blocks": [
        {
          "type": "episode",
          "settings": {
            "title": "Finding Your Breath After Birth",
            "season": "1",
            "episode": "1",
            "guest": "Clara Ostova",
            "guest_role": "Postpartum Doula",
            "description": "In this episode Clara shares practical breathing techniques, circle support dynamics, and physical recovery expectations.",
            "audio_url": "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",
            "duration": "28:45"
          }
        },
        {
          "type": "episode",
          "settings": {
            "title": "Empowered Parenting & Resilience",
            "season": "1",
            "episode": "2",
            "guest": "Marcus Aurelius",
            "guest_role": "Founder, Fatherhood Circle",
            "description": "Marcus breaks down the role of fatherhood groups, active partner care, and building resilient homes.",
            "audio_url": "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3",
            "duration": "35:10"
          }
        }
      ]
    }
  ]
}
{% endschema %}
